\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Edit benchmark, skill version~10.1, continued from Table~\ref {tab:edit}. Quality: 1--10. Stmts.\ rem.\,/\,chg.: statements removed and changed per text (blind meaning check). Voice: writer's voice kept, 1--10. AUC: each text version against the originals, for each judge (abstracts: journal editor, ISEF judge; appeals: donor, NGO editor; learner essays: writing researcher, teacher). D1--D3: mean detector scores (0--100, probability of AI); Pass: share passing at 50 (all three below 50). The detectors cannot score Turkish.}}{17}{table.caption.41}\protected@file@percent }
\newlabel{tab:edit-full}{{5}{17}{Edit benchmark, skill version~10.1, continued from Table~\ref {tab:edit}. Quality: 1--10. Stmts.\ rem.\,/\,chg.: statements removed and changed per text (blind meaning check). Voice: writer's voice kept, 1--10. AUC: each text version against the originals, for each judge (abstracts: journal editor, ISEF judge; appeals: donor, NGO editor; learner essays: writing researcher, teacher). D1--D3: mean detector scores (0--100, probability of AI); Pass: share passing at 50 (all three below 50). The detectors cannot score Turkish}{table.caption.41}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Version~11 against version~10.1 on the edit benchmark, development and test halves. $\Delta $: version~11 minus version~10.1, paired by text, with 95\% intervals; paired over 16 texts, except abstracts development and appeals test (15). No meaning change: share of ``improve it'' edits in which the meaning check found no change (version~10.1 / version~11). Voice kept: on ``improve it'', 1--10 (version~10.1 / version~11). In these two columns, version~10.1 values come from the first meaning check and version~11 values from a separate check run of the same design.}}{17}{table.caption.42}\protected@file@percent }
\newlabel{tab:v11}{{6}{17}{Version~11 against version~10.1 on the edit benchmark, development and test halves. $\Delta $: version~11 minus version~10.1, paired by text, with 95\% intervals; paired over 16 texts, except abstracts development and appeals test (15). No meaning change: share of ``improve it'' edits in which the meaning check found no change (version~10.1 / version~11). Voice kept: on ``improve it'', 1--10 (version~10.1 / version~11). In these two columns, version~10.1 values come from the first meaning check and version~11 values from a separate check run of the same design}{table.caption.42}{}}
